# Eko Micro-Entrepreneur Worker — .gitignore

# Environment & Secrets — NEVER commit secrets
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# Databases & local state
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Android & Gradle
.gradle/
android/.gradle/
android/local.properties
android/*/build/
android/build/
android/app/build/
android/captures/
*.apk
*.ap_
*.aab
*.dex
*.class
*.keystore
*.jks

# Python
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.venv/
venv/
env/
.pytest_cache/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & OS
.DS_Store
Thumbs.db
.vscode/
.idea/
*.iml
.project
.settings/
.system_generated/
.artifacts/

