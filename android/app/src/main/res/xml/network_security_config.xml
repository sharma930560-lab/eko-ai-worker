<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Configuration — Production
    - HTTPS only for all traffic (no cleartext HTTP)
    - appassets.androidplatform.net: internal WebView asset loader (no real network)
    - onrender.com: production backend HTTPS
    - All cleartext traffic blocked globally
-->
<network-security-config>
    <!-- Block all cleartext by default (HTTPS only) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Android WebView asset loader domain — internal, HTTPS scheme in loader -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">appassets.androidplatform.net</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- Production backend (Render.com HTTPS) -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">onrender.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
