<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Config for Eko Field Worker
    DEBUG/LOCAL DEV ONLY: Cleartext HTTP traffic is permitted for local development
    endpoints (10.0.2.2 emulator loopback, localhost, and WebView asset domain).
    For production builds, cleartextTrafficPermitted must be disabled and all API
    endpoints must be served over HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">appassets.androidplatform.net</domain>
    </domain-config>
</network-security-config>
