# Environment Variables — copy to .env and fill real values
# NEVER commit .env to git

# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE

# Local AI (preferred): install Ollama and run `ollama run qwen3:4b`
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Optional hosted fallback. Use only an operator-managed server secret.
# AI_PROVIDER=gemini
# GEMINI_API_KEY=provided-at-deployment-time

# Environment: development | production
ENVIRONMENT=development

# Database:
#   Development (SQLite): sqlite:///./eko_data.db
#   Production (PostgreSQL): postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./eko_data.db

# CORS origins (comma-separated). Production must include Android WebView origin.
# Default (dev): http://localhost:3000,http://127.0.0.1:3000
# Production:    https://appassets.androidplatform.net,http://appassets.androidplatform.net,https://eko-field-worker.netlify.app
ALLOWED_ORIGINS=https://appassets.androidplatform.net,http://appassets.androidplatform.net,https://eko-field-worker.netlify.app,http://localhost:3000,http://127.0.0.1:3000
